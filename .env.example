# Firebase 配置
# 從 Firebase 控制面板獲取這些值

# Firebase API 密鑰
VITE_FIREBASE_API_KEY=your_api_key_here

# Firebase 認證域
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain.firebaseapp.com

# Firebase 項目 ID
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase 儲存桶
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket.appspot.com

# Firebase 消息發送方 ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Firebase 應用 ID
VITE_FIREBASE_APP_ID=your_app_id

# Alpha Vantage API 配置
# 從 https://www.alphavantage.co 免費獲取 API 密鑰

# Alpha Vantage API 密鑰
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# API 基礎 URL
VITE_API_BASE_URL=https://www.alphavantage.co

# 應用環境
VITE_APP_ENV=development
